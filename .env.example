# Required
DISCORD_TOKEN=replace-with-a-discord-bot-token
OWNER_ID=123456789012345678

# Ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen3-vl:4b
OLLAMA_VERIFIER_MODEL=qwen3-vl:4b
OLLAMA_VISION_MODEL=qwen3-vl:4b
OLLAMA_NUM_CTX=4096
OLLAMA_VERIFIER_NUM_CTX=2048
OLLAMA_MAX_RESPONSE_TOKENS=500
OLLAMA_COOLDOWN=1.5

# Behavior
COMMAND_PREFIX=..
VISION_ENABLED=true
AUTO_SEARCH_ENABLED=true
RANDOM_REPLY_CHANCE=0.33
LOG_MESSAGE_CONTENT=false
CONNECT4_SEARCH_DEPTH=5
CONNECT4_TIMEOUT_SECONDS=1800
CHESS_TIMEOUT_SECONDS=1800
CHESS_SKILL_LEVEL=3
CHESS_THINK_SECONDS=0.15
# SYSTEM_PROMPT_FILE=/app/config/system-prompt.txt

# Persistent paths (the defaults match compose.example.yaml)
CHROMA_PATH=/app/database/chroma
STATS_DB_PATH=/app/database/stats.db
PERMS_DIR=/app/database/permissions
MEDIA_BASE=/app/media
LOG_DIR=/app/logs
